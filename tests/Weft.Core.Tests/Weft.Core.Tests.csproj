<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Le reste de la solution tourne en mode globalisation invariante, ce qui
         empeche materiellement un bug de culture. Les tests, eux, doivent
         pouvoir CHARGER une autre culture pour verifier que le code s'en moque :
         sinon on n'eprouve pas la propriete, on constate un reglage de build,
         et Weft.Core est une bibliotheque qu'un autre hote peut consommer sans
         ce reglage. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Weft.Core\Weft.Core.csproj" />
  </ItemGroup>

</Project>