# Copy to .env and fill in. Never commit the real file.

# Required. Machines present this once, when they enrol.
#   openssl rand -hex 32
WEFT_JOIN_SECRET=

# Oldest weft build allowed to write. Reads are never blocked by version.
WEFT_MIN_CLIENT=0.0.0

# Largest single object the server accepts, in bytes.
# 64 MiB of content plus the 29-byte encryption overhead.
WEFT_MAX_OBJECT_BYTES=67108893

# Host port to publish.
WEFT_PORT=8080
