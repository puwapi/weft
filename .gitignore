# .NET build output.
#
# 'bin/' and 'obj/' already cover everything the SDK emits, and the usual
# '[Dd]ebug/' and '[Rr]elease/' lines are not only redundant but harmful: they
# match ANY directory of that name. src/Weft.Core/Release/ was silently dropped
# from a commit by them, so the build passed here and failed on CI with a
# namespace that does not exist.
bin/
obj/
*.user
*.suo
TestResults/
artifacts/

# Published binaries
publish/
out/

# Editors
.vs/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# weft's own workspace metadata, if someone runs weft on this repo
.weft/

# Server publish output
publish-server/

# Local server configuration
.env
